{
  "name": "psb-quality-agent",
  "version": "1.0.0",
  "description": "Autonomous quality monitoring and maintenance agent for Professional Second Brain repository - continuous auditing, issue detection, trend analysis, auto-fixes, reporting, and recommendations",
  "main": "psb-quality-agent-core.ts",
  "types": "psb-quality-agent-types.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node psb-quality-agent-cli.ts",
    "start": "node dist/psb-quality-agent-cli.js",
    "scan": "ts-node -e \"import('./psb-quality-agent-cli').then(m => m.default.handleScan())\" --",
    "monitor": "ts-node -e \"import('./psb-quality-agent-cli').then(m => m.default.handleMonitor())\" --",
    "report": "ts-node -e \"import('./psb-quality-agent-cli').then(m => m.default.handleReport())\" --",
    "fix": "ts-node -e \"import('./psb-quality-agent-cli').then(m => m.default.handleFix())\" --",
    "schedule": "ts-node -e \"import('./psb-quality-agent-cli').then(m => m.default.handleSchedule())\" --",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "validate": "npm run lint && npm run build && npm run test",
    "docs": "typedoc --out docs --theme default psb-quality-agent-*.ts"
  },
  "keywords": [
    "quality-assurance",
    "autonomous-agent",
    "continuous-monitoring",
    "fabrication-detection",
    "evidence-verification",
    "confidentiality-audit",
    "consistency-checking",
    "auto-fix",
    "copilot",
    "skill",
    "professional-second-brain"
  ],
  "author": "Professional Second Brain Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typedoc": "^0.25.0"
  },
  "files": [
    "psb-quality-agent-*.ts",
    "psb-quality-agent-config.yaml",
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/professional-second-brain.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/professional-second-brain/issues"
  },
  "homepage": "https://github.com/your-org/professional-second-brain#readme"
}
