{
  "name": "psb-interview-prep-agent",
  "version": "1.0.0",
  "description": "Autonomous agent orchestrating comprehensive interview preparation for the Professional Second Brain",
  "main": "dist/psb-interview-prep-agent.js",
  "types": "dist/psb-interview-prep-agent.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prebuild": "npm run lint",
    "postbuild": "npm run test"
  },
  "keywords": [
    "interview",
    "preparation",
    "agent",
    "orchestration",
    "autonomous",
    "mock-interview",
    "coaching",
    "professional-development",
    "psb",
    "professional-second-brain"
  ],
  "author": "Professional Second Brain Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {},
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  },
  "typescript": {
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "lib": [
        "ES2020"
      ],
      "outDir": "./dist",
      "rootDir": "./src",
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "moduleResolution": "node"
    },
    "include": [
      "src/**/*"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "**/*.spec.ts",
      "**/*.test.ts"
    ]
  }
}
